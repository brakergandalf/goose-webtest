#!/usr/bin/env bash
# gwt — goose-webtest wrapper
# Provides clean environment, provider shortcuts, and bare-URL detection.
#
# Usage:
#   gwt run https://example.com                        # auto-discover mode
#   gwt run --target targets/sparkasse-demo.toml       # with target config
#   gwt run --provider claude --headed https://x.com   # claude + visible browser
#   gwt run --provider local --spec test-specs/s.md    # local vllm + spec

set -euo pipefail

# ── Environment ──────────────────────────────────────────────────────
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
export RUSTUP_TOOLCHAIN=stable
# Clean PATH: cargo, homebrew, system — skip conda, pyenv, etc.
export PATH="$CARGO_HOME/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BINARY="$SCRIPT_DIR/target/debug/goose"

if [[ ! -x "$BINARY" ]]; then
    echo "Binary not found at $BINARY"
    echo "Build first:  cargo build --features webtest -p goose-cli"
    exit 1
fi

# ── Parse args ───────────────────────────────────────────────────────
# Strip the leading "run" subcommand if present
args=("$@")
if [[ ${#args[@]} -gt 0 && "${args[0]}" == "run" ]]; then
    args=("${args[@]:1}")
fi

# Provider shortcut mapping (also sets default model)
resolved_provider=""
resolved_model=""

provider_map() {
    case "$1" in
        local|vllm|vllm_local)
            resolved_provider="vllm_local"
            resolved_model="mlx-community/Qwen3.5-35B-A3B-4bit"
            ;;
        claude|anthropic)
            resolved_provider="anthropic"
            resolved_model="claude-sonnet-4-6"
            ;;
        openrouter|or)
            resolved_provider="openrouter"
            ;;
        ollama)
            resolved_provider="ollama"
            ;;
        *)
            resolved_provider="$1"
            ;;
    esac
}

# Process args: expand --provider shortcuts, detect bare URLs
processed=()
has_provider=false
has_model=false
i=0
while [[ $i -lt ${#args[@]} ]]; do
    arg="${args[$i]}"
    case "$arg" in
        --provider)
            has_provider=true
            i=$((i + 1))
            if [[ $i -lt ${#args[@]} ]]; then
                provider_map "${args[$i]}"
                processed+=(--provider "$resolved_provider")
            else
                echo "Error: --provider requires a value"
                exit 1
            fi
            ;;
        --model)
            has_model=true
            i=$((i + 1))
            if [[ $i -lt ${#args[@]} ]]; then
                processed+=(--model "${args[$i]}")
            else
                echo "Error: --model requires a value"
                exit 1
            fi
            ;;
        http://*|https://*)
            # Bare URL → convert to --url flag
            processed+=(--url "$arg")
            ;;
        *)
            processed+=("$arg")
            ;;
    esac
    i=$((i + 1))
done

# Default provider if none specified
if ! $has_provider; then
    provider_map "vllm_local"
    processed=(--provider "$resolved_provider" "${processed[@]+"${processed[@]}"}")
fi

# Default model for the selected provider (if no --model given)
if ! $has_model && [[ -n "$resolved_model" ]]; then
    processed+=(--model "$resolved_model")
fi

# ── Logging ──────────────────────────────────────────────────────────
export RUST_LOG="${RUST_LOG:-info}"

# ── Execute ──────────────────────────────────────────────────────────
exec "$BINARY" test "${processed[@]+"${processed[@]}"}"
